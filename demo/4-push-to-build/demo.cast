[0.097, "o", "\n\n\n\u001b[K\u001b[13;2HDemo\u001b[C4:\u001b[Cfrom\u001b[Ca\u001b[Cpush\u001b[Cto\u001b[Ca\u001b[Crunning,\u001b[Cverified\u001b[Cimage\u001b[14;1H\u001b[K\n\u001b[K\u001b[15;2HOne\u001b[C'git\u001b[Cpush'.\u001b[CGitHub\u001b[Cdelivers\u001b[Cit\u001b[Cto\u001b[Cthe\u001b[Ccluster,\u001b[Ca\u001b[Cbuild\u001b[16;1H\u001b[K\u001b[16;2Hstarts\u001b[Con\u001b[Cits\u001b[Cown,\u001b[Cand\u001b[Cthe\u001b[Cimage\u001b[Cit\u001b[Cproduces\u001b[Cis\u001b[Csigned,\u001b[17;1H\u001b[K\u001b[17;2Hlogged\u001b[Cand\u001b[Cadmitted.\u001b[CNothing\u001b[Cafter\u001b[Cthe\u001b[Cpush\u001b[Cis\u001b[Crun\u001b[Cby\u001b[Chand\u001b[18;1H\u001b[K\u001b[18;2Hexcept\u001b[Cthe\u001b[Clast\u001b[Ccommand,\u001b[Cwhich\u001b[Cdeploys\u001b[Cthe\u001b[Cresult.\u001b[19;1H\u001b[K============================================================\u001b[20;1H\u001b[K\n\u001b[K###\u001b[Ca\u001b[Ccommit,\u001b[Cand\u001b[Ca\u001b[Cpush\u001b[22;1H\u001b[K\n\u001b[K$\u001b[Cgit\u001b[Ccommit\u001b[C--allow-empty\u001b[C-m\u001b[C'Trigger\u001b[Cthe\u001b[Csupply\u001b[Cchain'\u001b[24;1H\u001b[K\u001b[33m28b3b66 (\u001b[1m\u001b[36mHEAD\u001b[0m\u001b[33m -> \u001b[1m\u001b[32mpolicy-test\u001b[0m\u001b[33m)\u001b[C\u001b[39mTrigger\u001b[Cthe\u001b[Csupply\u001b[Cchain\u001b[25;1H\u001b[K\n\u001b[K$\u001b[Cgit\u001b[Cpush\u001b[Corigin\u001b[Cpolicy-test\u001b[27;1H\u001b[KTo\u001b[Cgithub.com:your-org/your-app.git\u001b[28;1H\u001b[K\u001b[3C3d3107a..28b3b66\u001b[2Cpolicy-test\u001b[C->\u001b[Cpolicy-test\u001b[29;1H\u001b[K\n\u001b[K###\u001b[CGitHub\u001b[Cdelivers\u001b[Cthe\u001b[Cpush\u001b[Cto\u001b[Cthe\u001b[Ccluster,\u001b[Cand\u001b[Can\u001b[CImageBuild\u001b[Cappears\u001b[31;1H\u001b[K\n\u001b[K\u001b[32;3Hname:\u001b[6Cyour-app-policy-test-28b3b664a673a30f97f493580e7e9595e606dbf6\u001b[33;1H\u001b[K\u001b[33;3Hrevision:\u001b[2Cpolicy-test\u001b[34;1H\u001b[K\u001b[34;3Hcommit:\u001b[4C28b3b664a673a30f97f493580e7e9595e606dbf6\u001b[35;1H\u001b[K\n\u001b[K###\u0