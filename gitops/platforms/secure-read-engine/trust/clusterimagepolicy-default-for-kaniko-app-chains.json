{
  "apiVersion": "policy.sigstore.dev/v1beta1",
  "kind": "ClusterImagePolicy",
  "metadata": {
    "finalizers": [
      "clusterimagepolicies.policy.sigstore.dev"
    ],
    "labels": {
      "blanketops.dev/managed": "true",
      "blanketops.dev/supply-chain-policy": "for-kaniko-app",
      "blanketops.dev/supply-chain-policy-namespace": "default"
    },
    "name": "default-for-kaniko-app-chains"
  },
  "spec": {
    "authorities": [
      {
        "ctlog": {
          "trustRootRef": "default-for-kaniko-app",
          "url": "https://rekor.172-18-255-200.nip.io"
        },
        "keyless": {
          "identities": [
            {
              "issuer": "https://spire-spiffe-oidc-discovery-provider.spire-server.svc.cluster.local",
              "subject": "spiffe://blanketops.dev/ns/tekton-chains/sa/tekton-chains-controller"
            }
          ],
          "trustRootRef": "default-for-kaniko-app",
          "url": "https://fulcio-server.fulcio-system.svc.cluster.local"
        },
        "name": "chains"
      }
    ],
    "images": [
      {
        "glob": "index.docker.io/nkanyezisolutions/for-kaniko-app**"
      }
    ],
    "mode": "enforce"
  }
}
